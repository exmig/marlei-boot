# Konfiguration der Web-Oberflaeche (wird nach /etc/pxeweb.env kopiert)

# Basis-URL, die in die iPXE-Skripte geschrieben wird. Diese Adresse muss
# der bootende Rechner erreichen koennen -- also die LAN-IP dieser VM,
# nicht "localhost". install.sh traegt hier die erkannte IP ein.
PXE_BASE_URL=http://192.168.178.30

# Ablageorte
PXE_CATALOG=/opt/pxeweb/catalog.yaml
PXE_ASSETS=/srv/pxe/assets
PXE_DB=/var/lib/pxeweb/pxeweb.db

# NFS-Export fuer grosse Live-Systeme. Ist er gesetzt, werden hochgeladene
# Ubuntu-Abbilder ausgepackt und beim Start ueber NFS gestreamt, statt
# komplett in den Arbeitsspeicher des bootenden Rechners geladen zu werden.
# Nur so startet ein 6 GB grosses Desktop-Abbild auf einem Rechner mit 8 GB.
#
# Dasselbe gilt fuer fuenf Eintraege des Katalogs: Linux Mint, Debian Live,
# SystemRescue, GParted und Clonezilla. Leer lassen schaltet den Weg ab --
# vier davon nehmen dann den Weg ueber HTTP und laden ihr
# Wurzeldateisystem in den Arbeitsspeicher. Nur Linux Mint kann das nicht
# (casper holt ueber HTTP das ganze Abbild, und eine ISO liegt hier
# nicht); es ist ohne Export nicht startbereit und sagt das unter Systeme.
# Der Pfad muss zu dem passen, was install.sh nach
# /etc/exports.d/pxe.exports geschrieben hat.
PXE_NFS_ROOT=/srv/pxe/assets

# Wake-on-LAN: Rundrufadresse, an die die Weckpakete gehen. Ein
# ausgeschalteter Rechner hat keine IP-Adresse und laesst sich nur ueber den
# Rundruf des eigenen Netzes ansprechen. install.sh traegt hier die passende
# Adresse ein (z. B. 192.168.178.255). Leer lassen heisst 255.255.255.255 --
# das geht ueber die Standardroute und tut es meistens auch.
PXE_WOL_BROADCAST=

# Ports, auf denen die Netzwerkkarten auf Weckpakete lauschen. 9 ist ueblich,
# 7 bedienen manche aelteren Karten. Beides zu schicken kostet nichts.
PXE_WOL_PORTS=9,7

# Sekunden, die das Boot-Menue auf eine Auswahl wartet, bevor der
# Standardeintrag startet. 0 = unendlich warten.
PXE_MENU_TIMEOUT=30

# Menuepunkt, der nach Ablauf des Timeouts startet.
# "local" = von der lokalen Festplatte booten (sicherer Standard).
PXE_MENU_DEFAULT=local

# Wie viele Tage zwischen zwei Durchgaengen des Waechters liegen, der die
# Download-Adressen des Katalogs durchsieht: welche tot ist, und wo es
# beim Anbieter etwas Neueres gibt. Der Befund steht danach auf Server
# Health in der Karte "Quelleninfo". Ein Durchgang kostet ein knappes
# Dutzend Anfragen und dauert eine knappe Minute.
# "aus" schaltet ihn ab -- dann wird nur noch geprueft, wenn jemand
# drueckt. Leer lassen heisst 7 Tage.
#
# ACHTUNG, seit 04.09.2026 ist das die Notbremse fuer JEDE Netzabfrage
# dieses Servers: Steht hier "aus", sieht er auch nicht mehr nach, ob es
# eine neuere Fassung von MARLEI Boot gibt -- und die Weboberflaeche kann
# das nicht ueberstimmen, sie zeigt dann nur, dass es abgeschaltet ist.
# Wie oft nach neuen Fassungen gesehen wird, stellt der Betreiber unter
# Einrichtung in der Karte "Stand" ein; es liegt neben der Datenbank und
# nicht hier, weil diese Datei nur beim Start des Dienstes gelesen wird.
PXE_QUELLENWACHT=7
